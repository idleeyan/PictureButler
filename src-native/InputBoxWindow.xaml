<Window x:Class="PictureButler.InputBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入" WindowStyle="None" Background="{StaticResource BgBrush}" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei UI, Segoe UI"
        Cursor="{DynamicResource CurArrow}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="{StaticResource TitleBarBrush}">
            <TextBlock x:Name="TitleText" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource TypeBodyLg}" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center"/>
            <Button Content="✕" Width="42" Height="30" HorizontalAlignment="Right" Style="{StaticResource CaptionBtn}" Click="Cancel_Click"/>
        </Grid>
        <StackPanel Grid.Row="1" Margin="16,14,16,4">
            <TextBlock x:Name="LabelText" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" Margin="0,0,0,6"/>
            <TextBox x:Name="InputBox" Style="{StaticResource SearchBox}" Height="32" VerticalContentAlignment="Center" KeyDown="InputBox_KeyDown"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,16,14">
            <Button Content="取消" Style="{StaticResource BtnGhost}" Click="Cancel_Click"/>
            <Button Content="确定" Style="{StaticResource BtnPrimary}" Margin="10,0,0,0" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
