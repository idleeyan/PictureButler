<Window x:Class="PictureButler.MergeSuggestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="建议合并" Width="640" Height="620" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" WindowStyle="None"
        Cursor="{DynamicResource CurArrow}"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>   <!-- 0: 自绘标题栏 -->
                <RowDefinition Height="Auto"/> <!-- 1: 说明 -->
                <RowDefinition Height="*"/>    <!-- 2: 列表 -->
                <RowDefinition Height="Auto"/> <!-- 3: 空态 -->
                <RowDefinition Height="Auto"/> <!-- 4: 操作 -->
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource TitleBarBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="建议合并" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource TypeBodyLg}"
                           FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="✕" Width="42" Height="30" Style="{StaticResource CaptionBtn}" Click="Cancel_Click" ToolTip="关闭 (Esc)"/>
            </Grid>

            <StackPanel Grid.Row="1" Margin="18,14,18,0">
                <TextBlock x:Name="HintText" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" TextWrapping="Wrap"
                           Text="以下人物的人脸特征高度相似，可能其实是同一个人。勾选后点「合并所选」即可把右侧人物并入左侧人物；合并后再次打开本页可继续收敛剩余相似项。"/>
            </StackPanel>

            <ScrollViewer Grid.Row="2" Margin="18,12,18,0" VerticalScrollBarVisibility="Auto" x:Name="ListScroller">
                <ItemsControl x:Name="SuggestList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="{StaticResource R3}" Margin="0,0,0,8" ClipToBounds="True"
                                    Background="{StaticResource CardBrush}" BorderBrush="Transparent" BorderThickness="1"
                                    MouseLeftButtonUp="Row_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SelectedStrongBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid Margin="10,9,12,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" Style="{StaticResource CheckBoxDark}" VerticalAlignment="Center"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}" Click="Chk_Click"/>

                                    <!-- 左侧（保留方） -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <Border Width="38" Height="38" CornerRadius="{StaticResource R3}" Background="{StaticResource OverlayBrush}" ClipToBounds="True">
                                            <Image Source="{Binding ThumbA}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding NameA}" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource TypeBody}"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="130"/>
                                            <TextBlock Text="{Binding CountTextA}" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 相似度 -->
                                    <Border Grid.Column="2" Background="{StaticResource AccentDimBrush}" CornerRadius="9" Padding="8,3" VerticalAlignment="Center" Margin="8,0">
                                        <TextBlock Text="{Binding SimText}" Foreground="White" FontSize="{StaticResource TypeCaption}" FontWeight="SemiBold"/>
                                    </Border>

                                    <!-- 右侧（被并入方） -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <Border Width="38" Height="38" CornerRadius="{StaticResource R3}" Background="{StaticResource OverlayBrush}" ClipToBounds="True">
                                            <Image Source="{Binding ThumbB}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding NameB}" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource TypeBody}"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="130"/>
                                            <TextBlock Text="{Binding CountTextB}" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 空态 -->
            <Border Grid.Row="3" x:Name="EmptyState" Visibility="Collapsed" Margin="18,16,18,0" Padding="20"
                    Background="{StaticResource CardBrush}" CornerRadius="{StaticResource R3}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="✓" Foreground="{StaticResource SuccessBrush}" FontSize="26" HorizontalAlignment="Center"/>
                    <TextBlock Text="没有找到相似度较高的人物" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="4" Margin="0,12,18,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="SelAllBtn" Content="全选" Style="{StaticResource ActionBtn}" Click="SelAll_Click"/>
                    <TextBlock x:Name="SelCountText" Text="已选 0 组" Foreground="{StaticResource AccentBrush}" FontSize="{StaticResource TypeCaption}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource BtnGhost}" Click="Cancel_Click"/>
                    <Button x:Name="OkBtn" Content="合并所选" Style="{StaticResource BtnPrimary}" Margin="10,0,0,0" Click="Ok_Click" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
