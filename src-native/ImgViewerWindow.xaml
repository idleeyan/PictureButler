<Window x:Class="PictureButler.ImgViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="图片查看"
        Icon="pack://application:,,,/app.ico"
        WindowStyle="None"
        Background="{StaticResource PanelDeepBrush}"
        Width="1180" Height="760"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Cursor="{DynamicResource CurArrow}"
        PreviewKeyDown="Window_KeyDown">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource PanelDeepBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="{StaticResource TitleBarBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ImgTitle" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource TypeBody}" Margin="16,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1" Content="✕" Width="42" Height="30" Style="{StaticResource CaptionBtn}" Tag="close" Click="CloseBtn_Click" ToolTip="关闭 (Esc)"/>
            </Grid>

            <!-- 左右分栏：左=大图，右=信息与操作 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- 左：大图 + 人脸框（滚轮缩放，拖拽平移） -->
                <Grid Grid.Column="0">
                    <ScrollViewer x:Name="ImgScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <!-- 图片与人脸框同处一个 Left/Top 容器，对容器统一缩放，保证任何缩放比例下框始终贴合图片 -->
                        <Grid x:Name="ImgHost" Margin="20" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Grid.LayoutTransform>
                                <ScaleTransform x:Name="HostTransform" ScaleX="1" ScaleY="1"/>
                            </Grid.LayoutTransform>
                            <Image x:Name="FullImage" Stretch="None" Cursor="SizeAll"
                                   MouseWheel="Image_MouseWheel" MouseDown="Image_MouseDown" MouseMove="Image_MouseMove" MouseUp="Image_MouseUp"/>
                            <Canvas x:Name="FaceCanvas" IsHitTestVisible="False"/>
                        </Grid>
                    </ScrollViewer>
                    <!-- 序列导航：上一张 / 下一张（遍历当前筛选完整结果） -->
                    <Button x:Name="PrevBtn" Content="‹" Width="40" Height="64" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="10,0,0,0" Click="Prev_Click" ToolTip="上一张 (←/A)" FontSize="{StaticResource TypeNavGlyph}" Foreground="{StaticResource TextBrush}"
                            Background="{StaticResource OverlayBarBrush}" BorderBrush="{StaticResource BorderBrush}" Cursor="{DynamicResource CurHand}"/>
                    <Button x:Name="NextBtn" Content="›" Width="40" Height="64" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,10,0" Click="Next_Click" ToolTip="下一张 (→/D)" FontSize="{StaticResource TypeNavGlyph}" Foreground="{StaticResource TextBrush}"
                            Background="{StaticResource OverlayBarBrush}" BorderBrush="{StaticResource BorderBrush}" Cursor="{DynamicResource CurHand}"/>
                    <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" Background="{StaticResource OverlayChipBrush}" CornerRadius="4" Padding="10,3">
                        <TextBlock x:Name="PosText" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource TypeCaption}" Text="" Visibility="Collapsed"/>
                    </Border>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,10" Background="{StaticResource OverlayChipBrush}" CornerRadius="4" Padding="8,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ZoomText" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource TypeCaption}" Text="100%"/>
                            <TextBlock Text="  ·  滚轮缩放 · Del 删除 · F2 重命名 · ←/→ 切换" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 右：详细信息与操作 -->
                <Border Grid.Column="1" Background="{StaticResource TitleBarBrush}" Padding="14,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="PromptText" Foreground="{StaticResource WarnBrush}" FontSize="{StaticResource TypeCaption}" TextWrapping="Wrap" LineHeight="18"/>
                                <TextBlock x:Name="MetaText" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" TextWrapping="Wrap" LineHeight="18" Margin="0,8,0,0"/>
                                <TextBlock x:Name="StatusText" Foreground="{StaticResource AccentBrush}" FontSize="{StaticResource TypeCaption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock x:Name="DescText" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource TypeCaption}" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="20"/>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="1">
                            <Button Content="打开" Style="{StaticResource ActionBtn}" Click="OpenFile_Click" Margin="0,0,0,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                            <Button Content="打开文件夹" Style="{StaticResource ActionBtn}" Click="OpenFolder_Click" Margin="0,0,0,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                            <Button Content="复制路径" Style="{StaticResource ActionBtn}" Click="CopyPath_Click" Margin="0,0,0,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                            <Button Content="复制描述" Style="{StaticResource ActionBtn}" Click="CopyDesc_Click" Margin="0,0,0,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                            <Button Content="复制图片文件" Style="{StaticResource ActionBtn}" Click="CopyFile_Click" Margin="0,0,0,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                            <Button Content="识别人脸" Style="{StaticResource ActionBtn}" Click="FaceOne_Click" Margin="0,0,0,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                            <Button Content="AI 打标" Style="{StaticResource ActionBtn}" Click="TagOne_Click" Margin="0,0,0,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                            <Button Content="设为壁纸" Style="{StaticResource ActionBtn}" Click="SetWallpaper_Click" Margin="0,0,0,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                            <Button Content="重命名" Style="{StaticResource ActionBtn}" Click="Rename_Click" Margin="0,0,0,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                            <!-- 危险操作独立：与常规操作拉开距离，改用红色系 -->
                            <Button Content="删除（回收站）" Style="{StaticResource BtnDanger}" Click="Delete_Click" Margin="0,8,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
