<Window x:Class="PictureButler.PersonPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="合并到其他人物" Width="460" Height="580" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" WindowStyle="None"
        Cursor="{DynamicResource CurArrow}"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>   <!-- 0: 自绘标题栏 -->
                <RowDefinition Height="Auto"/> <!-- 1: 说明 -->
                <RowDefinition Height="Auto"/> <!-- 2: 搜索框 -->
                <RowDefinition Height="*"/>    <!-- 3: 人物列表 -->
                <RowDefinition Height="Auto"/> <!-- 4: 空态 -->
                <RowDefinition Height="Auto"/> <!-- 5: 操作 -->
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource TitleBarBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Grid.Column="0" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource TypeBodyLg}" FontWeight="SemiBold"
                           Margin="16,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1" Content="✕" Width="42" Height="30" Style="{StaticResource CaptionBtn}" Click="Cancel_Click" ToolTip="关闭 (Esc)"/>
            </Grid>

            <TextBlock Grid.Row="1" Text="选择要合并到的目标人物（该人物全部照片与封面将并入目标）"
                       Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}"
                       Margin="18,14,18,0" TextWrapping="Wrap"/>

            <!-- 搜索框 -->
            <Grid Grid.Row="2" Margin="18,12,18,0">
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}"
                         FontSize="{StaticResource TypeBody}" Foreground="{StaticResource TextBrush}"
                         Padding="36,0,12,0" Height="38" VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"
                         ToolTip="输入人物姓名搜索"/>
                <TextBlock Text="🔍" Foreground="{StaticResource TextFaintBrush}" FontSize="{StaticResource TypeBody}"
                           VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"/>
            </Grid>

            <ScrollViewer Grid.Row="3" Margin="18,12,18,0" VerticalScrollBarVisibility="Auto" x:Name="ListScroller">
                <ItemsControl x:Name="PersonList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="ItemBorder" CornerRadius="{StaticResource R3}" Margin="0,0,0,8" Cursor="{DynamicResource CurHand}"
                                    Background="{StaticResource CardBrush}" BorderBrush="Transparent" BorderThickness="1"
                                    ClipToBounds="True" MouseLeftButtonUp="Person_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentDimBrush}"/>
                                            </Trigger>
                                            <!-- 选中态：底色换成高对比蓝底 + 蓝色描边（与卡片底 #191D28 拉开差异） -->
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SelectedStrongBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <!-- ① 左侧强调竖条（选中才出现） -->
                                    <Rectangle Width="3" HorizontalAlignment="Left" Fill="{StaticResource AccentBrush}">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>

                                    <StackPanel Orientation="Horizontal" Margin="13,8,10,8">
                                        <!-- ② 头像：选中时加蓝色描边 -->
                                        <Border Width="46" Height="46" CornerRadius="{StaticResource R3}" Background="{StaticResource OverlayBrush}"
                                                ClipToBounds="True" BorderThickness="2" BorderBrush="Transparent">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                                        </Border>
                                        <!-- ③ 文字：选中时名字变强调色 -->
                                        <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontSize="{StaticResource TypeBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding PhotoCountText}" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- ④ 右侧勾选标记（选中才出现） -->
                                    <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource AccentBrush}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Path Data="M4,11.5 L9,16.5 L18,6.5" Stroke="White" StrokeThickness="2.2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="None"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 空态 -->
            <Border Grid.Row="4" x:Name="EmptyState" Visibility="Collapsed" Margin="18,0,18,0" Padding="20"
                    Background="{StaticResource CardBrush}" CornerRadius="{StaticResource R3}" HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="∅" Foreground="{StaticResource TextFaintBrush}" FontSize="28" HorizontalAlignment="Center"/>
                    <TextBlock Text="没有匹配的人物" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="5" Margin="0,12,18,16">
                <TextBlock x:Name="SelHint" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="18,0,0,0"
                           Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}"
                           Text="未选择目标人物" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource BtnGhost}" Click="Cancel_Click"/>
                    <Button x:Name="OkBtn" Content="确认合并" Style="{StaticResource BtnPrimary}" Margin="10,0,0,0" Click="Ok_Click" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
