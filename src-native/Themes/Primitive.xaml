<!-- ==============================================================================
     PictureButler · 原语层（Primitive）
     只存原始色值，任何控件 / 业务 XAML 都不得直接引用本文件的键。
     业务引用的是 Themes/Semantic.*.xaml 里的语义画笔。
     ============================================================================== -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 中性（深侧） ===== -->
    <Color x:Key="P.White">#FFFFFF</Color>
    <Color x:Key="P.N50">#5A6480</Color>
    <Color x:Key="P.N75">#9AA3B5</Color>
    <Color x:Key="P.N100">#E8EAF2</Color>
    <Color x:Key="P.N150">#B9C0D0</Color>
    <Color x:Key="P.N200">#4C566E</Color>
    <Color x:Key="P.N250">#35405A</Color>
    <Color x:Key="P.N300">#2E3545</Color>
    <Color x:Key="P.N350">#2A3040</Color>
    <Color x:Key="P.N400">#3A4256</Color>
    <Color x:Key="P.N450">#333A4D</Color>
    <Color x:Key="P.N550">#10131A</Color>
    <Color x:Key="P.N600">#191D28</Color>
    <Color x:Key="P.N650">#1B1E28</Color>
    <Color x:Key="P.N700">#20242F</Color>
    <Color x:Key="P.N750">#232735</Color>
    <Color x:Key="P.N800">#161A24</Color>
    <Color x:Key="P.N900">#141922</Color>

    <Color x:Key="P.Selected">#242E44</Color>
    <Color x:Key="P.SelectedStrong">#2C4272</Color>
    <Color x:Key="P.NavHover">#262B3A</Color>

    <!-- ===== 中性（浅侧） ===== -->
    <Color x:Key="P.L.Canvas">#F2F4F7</Color>
    <Color x:Key="P.L.TitleBar">#FFFFFF</Color>
    <Color x:Key="P.L.Panel">#FFFFFF</Color>
    <Color x:Key="P.L.PanelAlt">#F7F8FA</Color>
    <Color x:Key="P.L.Sunken">#EFF1F5</Color>
    <Color x:Key="P.L.Deep">#E8EBF1</Color>
    <Color x:Key="P.L.Border">#E2E6EC</Color>
    <Color x:Key="P.L.BorderStrong">#C6CDD8</Color>
    <Color x:Key="P.L.Hover">#F0F2F6</Color>
