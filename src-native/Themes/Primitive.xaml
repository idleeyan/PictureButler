    <!-- ===== 遮罩（带 alpha，前两位为不透明度） ===== -->
    <Color x:Key="P.ScrimD">#B010131A</Color>
    <Color x:Key="P.ScrimL">#8F141A24</Color>
    <Color x:Key="P.BarD">#99161A24</Color>
