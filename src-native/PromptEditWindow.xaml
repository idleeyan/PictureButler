<Window x:Class="PictureButler.PromptEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑提示词" WindowStyle="None" AllowsTransparency="False"
        Background="{StaticResource BgBrush}" Width="640" Height="560" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei UI, Segoe UI"
        Cursor="{DynamicResource CurArrow}"
        SizeToContent="Manual" ResizeMode="CanResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Background="{StaticResource TitleBarBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="WindowTitleText" Grid.Column="0" Text="编辑提示词" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource TypeBodyLg}" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="✕" Width="42" Height="30" Style="{StaticResource CaptionBtn}" Click="CloseBtn_Click" ToolTip="关闭"/>
        </Grid>

        <!-- 表单 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,20,12">
                <TextBlock Text="卡片封面（编辑后点击保存生效）" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" Margin="0,14,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="132"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="CoverPreview" Grid.Column="0" Width="126" Height="90" CornerRadius="8" Background="{StaticResource PanelDeepBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" VerticalAlignment="Top">
                        <Grid>
                            <TextBlock x:Name="CoverPlaceholder" Text="无封面" Foreground="{StaticResource TextFaintBrush}" FontSize="{StaticResource TypeCaption}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="CoverImage" Stretch="Uniform" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <Button x:Name="PickFileBtn" Content="选择图片…" Style="{StaticResource ActionBtn}" Click="PickFile_Click" HorizontalAlignment="Left"/>
                        <Button x:Name="RemoveCoverBtn" Content="移除封面" Style="{StaticResource ActionBtn}" Click="RemoveCover_Click" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="CoverHint" Text="" Foreground="{StaticResource AccentBrush}" FontSize="{StaticResource TypeCaption}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <!-- 从已有图片选择封面 -->
                <TextBlock x:Name="GalleryLabel" Text="从已有图片中选择封面（点击设为封面）：" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" Margin="0,14,0,6" Visibility="Collapsed"/>
                <ItemsControl x:Name="GalleryPick" Visibility="Collapsed">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="84" Height="60" Margin="0,0,8,8" Cursor="{DynamicResource CurHand}" Click="GalleryThumb_Click" Tag="{Binding}"
                                    Background="{StaticResource PanelDeepBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{StaticResource PanelDeepBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <Image Source="{Binding Thumb}" Stretch="Uniform" Margin="2"/>
                                    <Button Content="✕" Width="16" Height="16" Margin="0,3,3,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Background="{StaticResource DangerBrush}" Foreground="White" FontSize="{StaticResource TypeCaption}" FontWeight="Bold" Padding="0" BorderThickness="0"
                                            Click="GalleryRemove_Click" Tag="{Binding}" ToolTip="删除这张图片" Cursor="{DynamicResource CurHand}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="标题" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" Margin="0,14,0,6"/>
                <TextBox x:Name="TitleBox" Style="{StaticResource SearchBox}" Height="32" VerticalContentAlignment="Center"/>

                <TextBlock Text="提示词内容" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" Margin="0,14,0,6"/>
                <TextBox x:Name="ContentBox" Style="{StaticResource SearchBox}" Height="200" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12,8" VerticalContentAlignment="Top"/>

                <TextBlock Text="标签（逗号分隔）" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" Margin="0,14,0,6"/>
                <TextBox x:Name="TagsBox" Style="{StaticResource SearchBox}" Height="32" VerticalContentAlignment="Center"/>

                <TextBlock Text="分类" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" Margin="0,14,0,6"/>
                <TextBox x:Name="CategoryBox" Style="{StaticResource SearchBox}" Height="32" VerticalContentAlignment="Center"/>

                <CheckBox x:Name="StarredChk" Content="星标" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource TypeBody}" Margin="0,16,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,20,16">
            <Button Content="取消" Style="{StaticResource BtnGhost}" Click="Cancel_Click"/>
            <Button x:Name="SaveBtn" Content="保存" Style="{StaticResource BtnPrimary}" Margin="10,0,0,0" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
