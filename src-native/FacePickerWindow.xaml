<Window x:Class="PictureButler.FacePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="更换封面" Width="560" Height="520" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" WindowStyle="None" ResizeMode="CanResize"
        Cursor="{DynamicResource CurArrow}"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>   <!-- 0: 自绘标题栏（与主窗/编辑窗同规格） -->
                <RowDefinition Height="Auto"/> <!-- 1: 说明 -->
                <RowDefinition Height="*"/>    <!-- 2: 人脸列表 -->
                <RowDefinition Height="Auto"/> <!-- 3: 操作 -->
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource TitleBarBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Grid.Column="0" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource TypeBodyLg}" FontWeight="SemiBold"
                           Margin="16,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1" Content="✕" Width="42" Height="30" Style="{StaticResource CaptionBtn}" Click="Cancel_Click" ToolTip="关闭 (Esc)"/>
            </Grid>

            <TextBlock x:Name="HintText" Grid.Row="1" Text="选择一张人脸作为封面"
                       Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}"
                       Margin="18,14,18,0" TextWrapping="Wrap"/>

            <ScrollViewer Grid.Row="2" Margin="18,12,18,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="FaceList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBrush}" CornerRadius="{StaticResource R4}" Padding="8" Margin="0,0,10,10" Cursor="{DynamicResource CurHand}"
                                    MouseLeftButtonUp="Face_Click" ToolTip="点击设为封面">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <Border Width="96" Height="96" CornerRadius="{StaticResource R3}" Background="{StaticResource SelectedBrush}">
                                        <Image Source="{Binding ThumbUrl}" Width="96" Height="96" Stretch="UniformToFill" ClipToBounds="True"/>
                                    </Border>
                                    <TextBlock Text="{Binding ScoreText}" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeMicro}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,18,16">
                <Button Content="取消" Style="{StaticResource BtnGhost}" Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
