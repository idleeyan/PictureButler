<Application x:Class="PictureButler.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:sw="clr-namespace:System.Windows;assembly=PresentationFramework">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 原语层：只存色值，任何控件都不得直接引用其中的键 -->
                <ResourceDictionary Source="Themes/Primitive.xaml"/>
                <!-- 语义层（深色为默认）：换主题 = 只替换这一个槽位（红线 R10，禁止逐个 Brush 赋值） -->
                <ResourceDictionary Source="Themes/Semantic.Dark.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ================================================================ -->
            <!-- ===== 侧栏导航图标（红线 R8：一律 Path 矢量，禁位图/字体图标）===== -->
            <!-- 坐标统一用 20×20 画布，实际尺寸由 Path 的 Stretch=Uniform 决定   -->
            <!-- ================================================================ -->
            <StreamGeometry x:Key="GeoNavPrompts">M3 5.5a1.8 1.8 0 0 1 1.8-1.8h10.4A1.8 1.8 0 0 1 17 5.5v5.9a1.8 1.8 0 0 1-1.8 1.8H8.2L5 16.2v-3H4.8A1.8 1.8 0 0 1 3 11.4z M6.4 7.4h7.2 M6.4 10h5</StreamGeometry>
            <StreamGeometry x:Key="GeoNavImages">M4.4 4.2h11.2a1.4 1.4 0 0 1 1.4 1.4v8.8a1.4 1.4 0 0 1-1.4 1.4H4.4a1.4 1.4 0 0 1-1.4-1.4V5.6a1.4 1.4 0 0 1 1.4-1.4z M3.4 14.2l3.4-3.9 2.4 2.7 2.3-2.6 2.7 3.2</StreamGeometry>
            <StreamGeometry x:Key="GeoNavIdPhotos">M3.6 4.4h12.8a1.4 1.4 0 0 1 1.4 1.4v8.4a1.4 1.4 0 0 1-1.4 1.4H3.6a1.4 1.4 0 0 1-1.4-1.4V5.8a1.4 1.4 0 0 1 1.4-1.4z M7.4 7.6a1.6 1.6 0 1 0 3.2 0a1.6 1.6 0 1 0-3.2 0 M5.4 13.4c0-2.1 1.9-3.4 4.6-3.4s4.6 1.3 4.6 3.4</StreamGeometry>
            <StreamGeometry x:Key="GeoNavDocs">M6.4 3.6h5.2l3.6 3.6v8.8a1.2 1.2 0 0 1-1.2 1.2H6.4a1.2 1.2 0 0 1-1.2-1.2V4.8a1.2 1.2 0 0 1 1.2-1.2z M11.6 3.6v3.6h3.6 M8 11h4.6 M8 13.6h3.2</StreamGeometry>
            <StreamGeometry x:Key="GeoNavSettings">M7.4 10a2.6 2.6 0 1 0 5.2 0a2.6 2.6 0 1 0-5.2 0 M10 2.2v2.2 M10 15.6v2.2 M2.2 10h2.2 M15.6 10h2.2 M4.5 4.5l1.5 1.5 M14 14l1.5 1.5 M15.5 4.5L14 6 M6 14l-1.5 1.5</StreamGeometry>

            <!-- ================================================================ -->
            <!-- ===== 尺度令牌（UI视觉升级计划 §2 / 界面设计方案 v2 §4）        ===== -->
            <!-- 画刷一律来自语义层；此之后不得再出现 #RRGGBB                     -->
            <!-- ================================================================ -->

            <!-- 说明：标题栏按钮的 hover / 关闭「按下」颜色在 Storyboard 里需要 Color 值，
                 因此以 Color 资源的形式放在语义层（Two themes 各一份），保证浅色下也正确。 -->

        <sys:Double x:Key="TypeMicro">10</sys:Double>        <!-- 角标计数、极弱注释 -->
        <sys:Double x:Key="TypeCaption">11</sys:Double>      <!-- 说明、路径、次要元数据 -->
        <sys:Double x:Key="TypeBody">12.5</sys:Double>       <!-- 正文、按钮文案 -->
        <sys:Double x:Key="TypeBodyLg">13.5</sys:Double>     <!-- 列表主文案、卡片标题 -->
        <sys:Double x:Key="TypeTitle">15</sys:Double>        <!-- 弹窗标题、区块标题 -->
        <sys:Double x:Key="TypeSection">17</sys:Double>      <!-- 查看器/设置大标题 -->
        <sys:Double x:Key="TypeDisplay">24</sys:Double>      <!-- 空态主句（仅空态） -->
        <sys:Double x:Key="TypeBadgeGlyph">8.5</sys:Double>  <!-- 例外：图片卡「脸/标/词」单字徽章 -->
        <sys:Double x:Key="TypeNavGlyph">30</sys:Double>     <!-- 例外：查看器 ‹ › 大箭头（字形非文字） -->

        <!-- ===== 间距六档（sys:Double，数值只取 4/8/12/16/20/24；半像素与游离值禁用） ===== -->
        <sys:Double x:Key="S1">4</sys:Double>
        <sys:Double x:Key="S2">8</sys:Double>
        <sys:Double x:Key="S3">12</sys:Double>
        <sys:Double x:Key="S4">16</sys:Double>
        <sys:Double x:Key="S5">20</sys:Double>
        <sys:Double x:Key="S6">24</sys:Double>

        <!-- ===== 圆角五档 ===== -->
        <CornerRadius x:Key="R1">4</CornerRadius>
        <CornerRadius x:Key="R2">6</CornerRadius>
        <CornerRadius x:Key="R3">8</CornerRadius>
        <CornerRadius x:Key="R4">10</CornerRadius>
        <CornerRadius x:Key="R5">999</CornerRadius>

        <!-- ===== 动效时长（120/180/240ms；只动 opacity 与 ≤3px translate，滚动区零动效） ===== -->
        <sys:String x:Key="DurFast">0:0:0.120</sys:String>
        <sys:String x:Key="DurBase">0:0:0.180</sys:String>
        <sys:String x:Key="DurSlow">0:0:0.240</sys:String>

        <!-- ===== 转换器 ===== -->
        <conv:BoolToVisibilityConverter x:Key="BoolVis" xmlns:conv="clr-namespace:PictureButler"/>
        <conv:StarColorConverter x:Key="StarColor" xmlns:conv="clr-namespace:PictureButler"/>

        <!-- ===== 专属光标（由 AppCursors.Apply 写入；启动时先放系统默认，避免解析期空引用） ===== -->
        <!-- 键名 CurArrow / CurHand；样式与业务 XAML 一律 DynamicResource。
             0.62.0 起手型光标废弃，CurHand 与 CurArrow 指向同一个棱角箭头（保留键名以免改几十处引用）。 -->

        <!-- ================================================================ -->
        <!-- ===== 既有控件样式 =====                                          -->
        <!-- 0.45.0 起删除 FilterCombo / FilterComboItem / FilterCycleBtn：   -->
        <!-- 筛选区已整体换成内联分段选择（技术红线 R1，禁止弹层回退）。       -->
        <!-- ================================================================ -->

        <!-- ===== 标题栏按钮（Ghost 语义） ===== -->
        <Style x:Key="CaptionBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="{StaticResource TypeCaption}"/>
            <Setter Property="Cursor" Value="{DynamicResource CurHand}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource R2}" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverStrongBrush}"/>
                                </Trigger>
                            <Trigger Property="Tag" Value="close">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="Background.Color" To="{StaticResource ColorCaptionClose}" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="Background.Color" To="{StaticResource ColorCaptionHover}" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 侧栏导航项：图标 + 文字 =====
             选中态刻意不用「一大块实底」——那会把侧栏切成五个色块、比内容还抢眼（违反「图优先」）。
             改用「3px 竖条 + 柔和蓝底 + 主色文字」三重冗余，扫视更快且不与内容争注意力。 -->
        <Style x:Key="NavBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource NavIdleBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource TypeBodyLg}"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="{DynamicResource CurHand}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <!-- 选中竖条：仅选中时可见 -->
                            <Border x:Name="bar" Width="3" HorizontalAlignment="Left" Margin="0,4"
                                    Background="{StaticResource AccentBrush}" CornerRadius="0,3,3,0"
                                    Visibility="Collapsed"/>
                            <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource R2}" Padding="10,8">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource NavHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 导航图标 Path：20×20 画布由 Stretch=Uniform 缩到实际尺寸；
             描边绑定父 RadioButton 的 Foreground，因此 hover / 选中会自动跟随变色 ===== -->
        <Style x:Key="NavIcon" TargetType="Path">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- ===== 搜索框 ===== -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="{StaticResource TypeBodyLg}"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource R3}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 筛选条里的小组标题（状态 / 排序 / 来源） ===== -->
        <Style x:Key="FilterGroupLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource TypeCaption}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <!-- ===== 内联筛选芯片（无弹层，替代下拉框；用于识别状态等分段选择） ===== -->
        <Style x:Key="FilterChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource TypeCaption}"/>
            <Setter Property="Cursor" Value="{DynamicResource CurHand}"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource R2}" Padding="9,4"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PanelAltBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 提示词列表项 ===== -->
        <Style x:Key="PromptItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource R3}" BorderThickness="1" BorderBrush="Transparent" Padding="14,10" Margin="2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PanelAltBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SelectedBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 单选选项按钮（页签 / 分段控件基类） ===== -->
        <Style x:Key="OptionBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource TypeBody}"/>
            <Setter Property="Margin" Value="0,0,22,0"/>
            <Setter Property="Cursor" Value="{DynamicResource CurHand}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="dot" Width="16" Height="16" CornerRadius="{StaticResource R5}" Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1.5" VerticalAlignment="Center"/>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter TargetName="dot" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="dot" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 操作按钮（Secondary 基类） ===== -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="{StaticResource TypeBody}"/>
            <Setter Property="Cursor" Value="{DynamicResource CurHand}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource R2}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ActionHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SelectedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================================================================ -->
        <!-- ===== 新增控件样式（0.45.0 定义；0.46.0 起逐窗应用）             ===== -->
        <!-- ================================================================ -->

        <!-- ===== 主操作按钮（每屏 ≤ 1） =====
             P0 修复：填充色改用 AccentSolidBrush。旧值用了 AccentBrush(#5B8DEF) 做实底，
             其上白字对比度实测仅 3.2:1，不达 WCAG AA 的 4.5:1；新值 #2E5FC0 为 5.97:1。
             AccentBrush 保留，仍用于「文字 / 图标 / 描边」场景（那里是深色底，本身达标）。 -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentSolidBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentSolidBrush}"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="{StaticResource TypeBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="{DynamicResource CurHand}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource R2}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSolidHoverBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentSolidHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSolidPressBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentSolidPressBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 幽灵按钮（次要操作：返回 / 取消多选等） ===== -->
        <Style x:Key="BtnGhost" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="{StaticResource TypeBody}"/>
            <Setter Property="Cursor" Value="{DynamicResource CurHand}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource R2}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SelectedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 危险按钮（删除类；实底确认变体见 BtnDangerSolid） ===== -->
        <Style x:Key="BtnDanger" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="{StaticResource TypeBody}"/>
            <Setter Property="Cursor" Value="{DynamicResource CurHand}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource R2}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource DangerBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 危险实底按钮（最终确认一步专用） ===== -->
        <Style x:Key="BtnDangerSolid" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="{StaticResource TypeBody}"/>
            <Setter Property="Cursor" Value="{DynamicResource CurHand}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource R2}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource DangerHoverBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource DangerHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource DangerPressBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource DangerPressBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 深色自绘勾选框（系统默认在深色下刺眼；18px 盒） ===== -->
        <Style x:Key="CheckBoxDark" TargetType="CheckBox">
            <Setter Property="Background" Value="{StaticResource OverlayBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource TypeBody}"/>
            <Setter Property="Cursor" Value="{DynamicResource CurHand}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="{StaticResource R1}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource OverlayLightBrush}" BorderThickness="1.5"
                                    VerticalAlignment="Center">
                                <Path x:Name="Tick" Data="M4,9 L8,13 L14.5,5"
                                      Stroke="White" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed" Stretch="Uniform" Margin="3"/>
                            </Border>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource OverlayStrongBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.45"/>
                                <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 深色滑块 SliderDark（仅配色覆盖，使用系统模板保证稳定；0.50 起） ===== -->
        <Style x:Key="SliderDark" TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="IsSelectionRangeEnabled" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ===== 深色滚动条（宽 10，滑块 BorderStrong 全圆，轨道透明；0.46 起全局挂载） ===== -->
        <Style x:Key="ScrollBtnTransparent" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollThumbDark" TargetType="Thumb">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <!-- 外层透明 Border 撑满整条宽度 →「命中区 = 整条滚动条宽」，
                             内层才是视觉上的细胶囊。若把 Margin 直接放在唯一的 Border 上，
                             细细的滚动条里真正能抓的宽度只剩不到 6px，鼠标稍偏就落到翻页按钮上，
                             表现为「滚轮能滚、但拖不动滑块」（用户实测反馈）。 -->
                        <Border Background="Transparent">
                            <Border x:Name="tb" Background="{StaticResource BorderStrongBrush}" CornerRadius="{StaticResource R5}" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tb" Property="Background" Value="{StaticResource ScrollThumbHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="tb" Property="Background" Value="{StaticResource AccentDimBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollBarDark" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="MinWidth" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollBtnTransparent}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollBtnTransparent}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumbDark}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="Height" Value="12"/>
                                <Setter Property="MinHeight" Value="12"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 深色右键菜单（MenuDark + MenuItemDark + 危险项 MenuItemDanger；0.46 起应用） ===== -->
        <Style x:Key="MenuItemDark" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource TypeBody}"/>
            <Setter Property="Cursor" Value="{DynamicResource CurHand}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource R1}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MenuItemDanger" TargetType="MenuItem" BasedOn="{StaticResource MenuItemDark}">
            <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource R1}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MenuDark" TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <!-- 注意：此处「绝不能」用 ItemContainerStyle 给菜单项上样式。
                 MenuBase 把 <Separator/> 也视作容器，ItemContainerStyle 会被套到 Separator 上，
                 抛 InvalidOperationException「用于类型 MenuItem 的样式不能应用于类型 Separator」→ 进程崩溃。
                 菜单项样式改由下方全局隐式 Style TargetType="MenuItem" 提供。 -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource R3}" Padding="4">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 菜单分隔线（MenuBase 按此键查找分隔线样式） ===== -->
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{TemplateBinding Background}" Margin="{TemplateBinding Margin}" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 深色 ToolTip（TypeCaption，max-width 280；0.46 起应用） ===== -->
        <Style x:Key="ToolTipDark" TargetType="ToolTip">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="{StaticResource PanelDeepBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource TypeCaption}"/>
            <Setter Property="MaxWidth" Value="280"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource R1}" Padding="8,5">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 统一焦点环（2px Accent 外描边） =====
             用系统焦点视觉资源键挂载：WPF 所有控件默认按此键查找 FocusVisualStyle，
             在此处覆盖即等于「全局挂载」，无需逐控件设 FocusVisualStyle。 -->
        <Style x:Key="{x:Static sw:SystemParameters.FocusVisualStyleKey}">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Stroke="{StaticResource AccentBrush}" StrokeThickness="2" SnapsToDevicePixels="True" Margin="-1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================================================================ -->
        <!-- ===== 全局默认样式（0.46.0 起挂载；无 x:Key 即为隐式样式）        ===== -->
        <!-- 滚动条 / 右键菜单 / 菜单项 / ToolTip 全应用统一深色，消除系统默认浅色出戏控件 -->
        <!-- ================================================================ -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBarDark}"/>
        <Style TargetType="ContextMenu" BasedOn="{StaticResource MenuDark}"/>
        <Style TargetType="MenuItem" BasedOn="{StaticResource MenuItemDark}"/>
        <Style TargetType="ToolTip" BasedOn="{StaticResource ToolTipDark}"/>

        </ResourceDictionary>
    </Application.Resources>
</Application>
