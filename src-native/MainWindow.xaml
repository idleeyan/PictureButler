<Window x:Class="PictureButler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PictureButler"
        mc:Ignorable="d"
        Title="PictureButler"
        Icon="pack://application:,,,/app.ico"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource BgBrush}"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Cursor="{DynamicResource CurArrow}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- ===== 设置页二级导航项（0.61.0 批次 3）：点击滚动定位，不改内容区结构 ===== -->
        <Style x:Key="SetNavBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource TypeBody}"/>
            <Setter Property="Cursor" Value="{DynamicResource CurHand}"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource R2}" Padding="12,7">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- ===== 多选勾选框（仅多选模式显示；MultiModeVisible 为窗口级 DP） ===== -->
        <Style x:Key="MultiChk" TargetType="CheckBox">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="7,7,0,0"/>
            <Setter Property="Cursor" Value="{DynamicResource CurHand}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Border x:Name="Box" Width="24" Height="24" CornerRadius="7"
                                    Background="{StaticResource OverlayBrush}" BorderBrush="{StaticResource OverlayLightBrush}" BorderThickness="1.5">
                                <Path x:Name="Tick" Data="M5,12 L10.5,17.5 L19,7"
                                      Stroke="White" StrokeThickness="2.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed" Stretch="Uniform" Margin="3"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource OverlayStrongBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding MultiModeVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ===== 提示词卡片模板（图片 + 星标 + 提示词；行高由 CardPreviewMaxHeight DP 驱动） ===== -->
        <DataTemplate x:Key="PromptCardTemplate">
            <Border CornerRadius="8" Margin="0,0,10,10" Padding="10" Cursor="{DynamicResource CurHand}" MouseLeftButtonUp="PromptCard_Click"
                    ToolTip="{Binding Title}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Selected}" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="复制标题" Click="PromptCtxCopyTitle_Click"/>
                        <MenuItem Header="复制内容" Click="PromptCtxCopyContent_Click"/>
                        <Separator/>
                        <MenuItem Header="编辑…" Click="PromptCtxEdit_Click"/>
                        <MenuItem Header="删除" Style="{StaticResource MenuItemDanger}" Click="PromptCtxDelete_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Style="{StaticResource MultiChk}" IsChecked="{Binding Selected, Mode=TwoWay}" ToolTip="选择"/>
                    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="6" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Width" Value="112"/>
                                <Setter Property="Height" Value="112"/>
                                <Style.Triggers>
                                    <!-- 图片墙：放大图片、隐藏右侧文字 → 卡片收成正方形，一行可放多个 -->
                                    <DataTrigger Binding="{Binding PromptWallMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Width" Value="160"/>
                                        <Setter Property="Height" Value="160"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Image Source="{Binding PreviewImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Width" Value="112"/>
                                        <Setter Property="Height" Value="112"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PromptWallMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="Width" Value="160"/>
                                                <Setter Property="Height" Value="160"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <!-- 图片墙已星标：金色描边覆盖层（不改 BorderThickness，避免挤动图片布局） -->
                            <Border CornerRadius="6" Background="Transparent" BorderThickness="1.5" IsHitTestVisible="False"
                                    BorderBrush="{StaticResource StarBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding PromptWallMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                    <Condition Binding="{Binding Starred}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <!-- 图片墙角标星：深色底片 + 金星，叠在图上；仅 wall + Starred 显示 -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                    Background="{StaticResource OverlayBarBrush}" CornerRadius="{StaticResource R1}" Padding="5,2"
                                    IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding PromptWallMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                    <Condition Binding="{Binding Starred}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="★" Foreground="{StaticResource StarBrush}" FontSize="{StaticResource TypeCaption}" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,2,2,2">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PromptWallMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <DockPanel>
                            <Button Content="★" Tag="{Binding Id}" Click="StarBtn_Click"
                                    Foreground="{Binding Starred, Converter={StaticResource StarColor}}"
                                    FontSize="{StaticResource TypeBodyLg}" Width="26" Height="22" Background="Transparent"
                                    BorderThickness="0" Cursor="{DynamicResource CurHand}" ToolTip="加入/取消星标" DockPanel.Dock="Left"/>
                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource TypeBody}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Content}" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}"
                                   TextTrimming="CharacterEllipsis" Margin="0,6,0,0"
                                   MaxHeight="{Binding CardPreviewMaxHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                   LineHeight="18"/>
                        <TextBlock Text="{Binding UpdatedDisplay}" Foreground="{StaticResource TextFaintBrush}" FontSize="{StaticResource TypeMicro}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>   <!-- 标题栏（批次 2c：44 → 36，方案 §2.1 硬指标）-->
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>   <!-- 0.61.0 批次 2b：常驻状态条 -->
        </Grid.RowDefinitions>

        <!-- ===== 自绘标题栏 ===== -->
        <Grid Grid.Row="0" Background="{StaticResource TitleBarBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- 品牌标记：16px 矢量几何（与浏览器扩展 popup 图标同源）。
                 Data 前缀 F0 = EvenOdd 填充，使内层菱形成为镂空；FillRule 不能作为 Path 属性直接写。 -->
            <Path Grid.Column="0" Data="F0 M8,0 L16,8 L8,16 L0,8 Z M8,4.6 L11.4,8 L8,11.4 L4.6,8 Z"
                  Fill="{StaticResource AccentBrush}"
                  Width="16" Height="16" Stretch="Uniform" Margin="16,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="PictureButler" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource TypeBodyLg}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                <Button x:Name="MinBtn" Content="─" Width="42" Height="30" Style="{StaticResource CaptionBtn}" Click="MinBtn_Click" ToolTip="最小化"/>
                <Button x:Name="MaxBtn" Content="□" Width="42" Height="30" Style="{StaticResource CaptionBtn}" Click="MaxBtn_Click" ToolTip="最大化"/>
                <Button x:Name="CloseBtn" Content="✕" Width="42" Height="30" Style="{StaticResource CaptionBtn}" Click="CloseBtn_Click" ToolTip="关闭"/>
            </StackPanel>
        </Grid>

        <!-- ===== 主体 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- 左侧导航 -->
            <Border Grid.Column="0" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="10,14,10,0">
                    <TextBlock Text="管理" Foreground="{StaticResource TextFaintBrush}" FontSize="{StaticResource TypeCaption}" Margin="10,0,0,6"/>
                    <RadioButton x:Name="NavPrompts" IsChecked="True" Style="{StaticResource NavBtn}" GroupName="nav" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIcon}" Data="{StaticResource GeoNavPrompts}"/>
                            <TextBlock Text="提示词" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavImages" Style="{StaticResource NavBtn}" GroupName="nav" Checked="Nav_Checked" ToolTip="图片库">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIcon}" Data="{StaticResource GeoNavImages}"/>
                            <TextBlock Text="图片库" VerticalAlignment="Center"/>
                            <Border x:Name="NavImagesBadge" Background="{StaticResource DangerBrush}" CornerRadius="8" MinWidth="16" Height="16" Padding="4,0"
                                    Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="NavImagesBadgeText" Text="" Foreground="White" FontSize="{StaticResource TypeMicro}" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavIdPhotos" Style="{StaticResource NavBtn}" GroupName="nav" Checked="Nav_Checked" ToolTip="证件类影像（身份证、行驶证、驾驶证等）">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIcon}" Data="{StaticResource GeoNavIdPhotos}"/>
                            <TextBlock Text="证件照" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavDocs" Style="{StaticResource NavBtn}" GroupName="nav" Checked="Nav_Checked" ToolTip="文件、通知书、纸质文献等">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIcon}" Data="{StaticResource GeoNavDocs}"/>
                            <TextBlock Text="文档" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <TextBlock Text="工具" Foreground="{StaticResource TextFaintBrush}" FontSize="{StaticResource TypeCaption}" Margin="10,18,0,6"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavBtn}" GroupName="nav" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIcon}" Data="{StaticResource GeoNavSettings}"/>
                            <TextBlock Text="设置" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <TextBlock Text="ComfyUI 生成后自动入库" Foreground="{StaticResource TextFaintBrush}" FontSize="{StaticResource TypeCaption}" TextWrapping="Wrap" Margin="14,22,6,0" LineHeight="17"/>
                    <TextBlock x:Name="HttpStatusText" Foreground="{StaticResource TextFaintBrush}" FontSize="{StaticResource TypeCaption}" TextWrapping="Wrap" Margin="14,10,6,0" LineHeight="16" Text="本地服务启动中…"/>
                    <Border Background="{StaticResource PanelAltBrush}" CornerRadius="6" Padding="10,7" Margin="10,16,10,0">
                        <TextBlock x:Name="VersionText" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" Text="版本读取中…" TextAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 右侧内容 -->
            <Grid Grid.Column="1" Background="{StaticResource PanelBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="DetailCol" Width="360"/>
                </Grid.ColumnDefinitions>

                <!-- 捕获/识别提示条（覆盖层，自动消失） -->
                <Border x:Name="NoticeBar" Grid.Column="0" Background="{StaticResource WarnSoftBrush}" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14,9" Margin="20,12,20,0" VerticalAlignment="Top" HorizontalAlignment="Center"
                        Visibility="Collapsed" IsHitTestVisible="False" MouseLeftButtonUp="NoticeBar_Click"
                        Panel.ZIndex="100">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="●" Foreground="{StaticResource StarBrush}" FontSize="{StaticResource TypeBodyLg}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="NoticeBarText" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource TypeBody}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                    <!-- 左栏：视图容器（提示词 / 图片库） -->
                    <Grid Grid.Column="0">

                        <!-- ===== 提示词视图 ===== -->
                        <Grid x:Name="PromptView">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="20,16,10,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SearchBox" Text="" Style="{StaticResource SearchBox}" VerticalContentAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <Button x:Name="PromptNewBtn" Content="＋ 新建" Style="{StaticResource BtnPrimary}" Click="NewPrompt_Click"/>
                                    <Button x:Name="PromptMultiBtn" Content="多选" Style="{StaticResource BtnGhost}" Click="PromptMulti_Click" Margin="8,0,0,0" ToolTip="批量选择后删除"/>
                                    <!-- 提示词视图切换：内联分段（红线禁止弹层）。图片墙 = 只显示图片，详情看右侧面板。
                                         「视图」是分组说明而非按钮：浅灰小字 + 不参与命中，与可点击芯片（FilterChip）在同一浅底容器内成组。 -->
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="{StaticResource R2}" Padding="2,2" Margin="16,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="视图" Foreground="{StaticResource TextFaintBrush}" FontSize="{StaticResource TypeCaption}"
                                                       VerticalAlignment="Center" Margin="10,0,8,0" IsHitTestVisible="False"/>
                                            <RadioButton x:Name="PromptViewList" Content="列表" GroupName="promptView" Style="{StaticResource FilterChip}" IsChecked="True"
                                                         Checked="PromptView_Changed" ToolTip="常规卡片：左侧图片 + 右侧标题与提示词"/>
                                            <RadioButton x:Name="PromptViewWall" Content="图片墙" GroupName="promptView" Style="{StaticResource FilterChip}"
                                                         Checked="PromptView_Changed" ToolTip="只显示图片（多列），选中项在右侧面板看完整信息"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="CountText" Text="共 0 条" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeBody}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <!-- 多选操作条 -->
                                    <StackPanel x:Name="PromptMultiBar" Orientation="Horizontal" Visibility="Collapsed" Margin="8,0,0,0">
                                        <TextBlock x:Name="PromptSelCount" Text="已选 0 项" Foreground="{StaticResource AccentBrush}" FontSize="{StaticResource TypeBody}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Button x:Name="PromptSelAllBtn" Content="全选" Style="{StaticResource ActionBtn}" Click="PromptSelAll_Click" Margin="0,0,8,0"/>
                                        <Button x:Name="PromptSelDelBtn" Content="删除所选" Style="{StaticResource BtnDanger}" Click="PromptSelDelete_Click" Margin="0,0,8,0"/>
                                        <Button Content="取消" Style="{StaticResource BtnGhost}" Click="PromptMultiCancel_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="PromptGrid" Margin="12,0,6,14" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- 空态三件套：空库 / 搜索无结果（按上下文动态显示） -->
                            <StackPanel x:Name="PromptEmptyBox" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="PromptEmptyTitle" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource TypeDisplay}" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440"/>
                                <TextBlock x:Name="PromptEmptyHint" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeBody}"
                                           Margin="0,10,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440"/>
                                <!-- 空态按钮用次要样式：本视图工具栏已有唯一主操作「＋ 新建」，
                                     若此处再用 BtnPrimary 会同屏出现两个主按钮（违反「每屏 Primary ≤ 1」）。 -->
                                <Button x:Name="PromptEmptyAction" Style="{StaticResource ActionBtn}" Margin="0,18,0,0" HorizontalAlignment="Center"
                                        Click="PromptEmptyAction_Click" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>

                        <!-- ===== 图片库视图 ===== -->
                        <Grid x:Name="ImgView" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>   <!-- 0: 搜索框 / 计数 -->
                                <RowDefinition Height="Auto"/>   <!-- 1: 页签 全部/人物/标签 + 操作栏 -->
                                <RowDefinition Height="Auto"/>   <!-- 2: 筛选条（状态 / 排序 / 来源，全内联） -->
                                <RowDefinition Height="*"/>      <!-- 3: 图片网格 -->
                                <RowDefinition Height="Auto"/>   <!-- 4: 分页 -->
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="20,16,10,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ImgSearchBox" Text="" Style="{StaticResource SearchBox}" VerticalContentAlignment="Center"/>
                                <TextBox x:Name="TagSearchBox" Text="" Style="{StaticResource SearchBox}" VerticalContentAlignment="Center" Visibility="Collapsed"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel x:Name="ImgTagChipPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed"/>
                                    <TextBlock x:Name="ImgCountText" Text="" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeBody}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- 页签：全部 / 人物 / 标签（证件照 / 文档在左侧一级导航）。
                                 0.61.0 批次 2b：整条工具条统一 48px 槽位，内容垂直居中
                                 0.61.2 批次 2c：常规态与多选态互斥，共用同一 48px 槽位（替换而非新增一行，零高度跳动） -->
                            <Border Grid.Row="1" Height="48" Margin="22,0,10,8">
                                <Grid>
                                <!-- 常规态工具条 -->
                                <StackPanel x:Name="ImgToolMain" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="ImgTabAll" Content="全部" GroupName="imgTab" Style="{StaticResource OptionBtn}" IsChecked="True" Checked="ImgTab_Changed"/>
                                <RadioButton x:Name="ImgTabPersons" Content="人物" GroupName="imgTab" Style="{StaticResource OptionBtn}" Checked="ImgTab_Changed"/>
                                <RadioButton x:Name="ImgTabTags" Content="标签" GroupName="imgTab" Style="{StaticResource OptionBtn}" Checked="ImgTab_Changed"/>
                                <Button x:Name="ImgBackBtn" Content="‹ 返回" Style="{StaticResource BtnGhost}" Visibility="Collapsed" Click="ImgBack_Click" Margin="16,0,0,0"/>
                                <!-- 标签/分类相册操作栏 -->
                                <StackPanel x:Name="TagActionBar" Orientation="Horizontal" Visibility="Collapsed" Margin="14,0,0,0">
                                    <TextBlock x:Name="TagNameText" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource TypeBodyLg}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button x:Name="TagAndBtn" Content="＋ 加入筛选(且)" Style="{StaticResource ActionBtn}" Click="TagAnd_Click" Margin="12,0,0,0" ToolTip="回到全部图片，并要求同时包含该标签（可叠加多个，取交集）"/>
                                    <Button x:Name="TagClearAndBtn" Content="清空标签筛选" Style="{StaticResource ActionBtn}" Click="TagClearAnd_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                                <!-- 人物相册操作栏（personPhotos 模式） -->
                                <StackPanel x:Name="PersonActionBar" Orientation="Horizontal" Visibility="Collapsed" Margin="14,0,0,0">
                                    <TextBlock x:Name="PersonNameText" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource TypeBodyLg}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PersonFaceCountText" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <Button Content="重命名" Style="{StaticResource ActionBtn}" Click="PersonRename_Click" Margin="16,0,0,0"/>
                                    <Button Content="换封面" Style="{StaticResource ActionBtn}" Click="PersonSetAvatar_Click" Margin="8,0,0,0"/>
                                    <Button Content="合并" Style="{StaticResource ActionBtn}" Click="PersonMerge_Click" Margin="8,0,0,0"/>
                                    <Button Content="删除" Style="{StaticResource BtnDanger}" Click="PersonDelete_Click" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="ImgRecognizeStatus" Foreground="{StaticResource AccentBrush}" FontSize="{StaticResource TypeCaption}" VerticalAlignment="Center" Margin="18,0,0,0"/>
                                <Button x:Name="ImgMultiBtn" Content="多选" Style="{StaticResource BtnGhost}" Click="ImgMulti_Click" Margin="14,0,0,0" ToolTip="批量选择后删除"/>
                                <Button x:Name="PersonMultiBtn" Content="多选" Style="{StaticResource BtnGhost}" Click="PersonMulti_Click" Visibility="Collapsed" Margin="14,0,0,0" ToolTip="批量选择人物后合并、忽略或删除"/>
                                <Button x:Name="MergeSuggestBtn" Content="建议合并" Style="{StaticResource ActionBtn}" Click="MergeSuggest_Click" Visibility="Collapsed" Margin="8,0,0,0" ToolTip="按人脸相似度自动找出可能属于同一个人的条目，可一键合并"/>
                                <Button x:Name="ImgRecognizeBtn" Content="识别图片（人脸）" Style="{StaticResource ActionBtn}" Click="ImgRecognize_Click" Margin="8,0,0,0"/>
                                <Button x:Name="ImgTagBtn" Content="AI 打标" Style="{StaticResource ActionBtn}" Click="ImgTag_Click" Margin="8,0,0,0"/>
                                <Button x:Name="ImgTagStopBtn" Content="停止" Style="{StaticResource BtnDanger}" Click="TagStop_Click" Margin="8,0,0,0" Visibility="Collapsed"
                                        ToolTip="中断当前的识别 / 打标任务（在当前图片处理完之后生效）"/>
                                <!-- 筛选行开关（批次 2b）：筛选行默认收起，内联展开，不违反红线 R1（禁止弹层） -->
                                <Button x:Name="ImgFilterToggle" Content="筛选 ▾" Style="{StaticResource BtnGhost}" Click="ImgFilterToggle_Click"
                                        Margin="14,0,0,0" ToolTip="展开 / 收起筛选条（识别状态 / 排序 / 来源）"/>
                                </StackPanel>
                                <!-- 多选态工具条（批次 2c）：进入多选时整条替换常规态，退出按钮在条内「取消」 -->
                                <StackPanel x:Name="ImgToolMulti" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <!-- 图片多选操作条 -->
                                <StackPanel x:Name="ImgMultiBar" Orientation="Horizontal" Visibility="Collapsed" Margin="8,0,0,0">
                                    <TextBlock x:Name="ImgSelCount" Text="已选 0 项" Foreground="{StaticResource AccentBrush}" FontSize="{StaticResource TypeBody}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Button x:Name="ImgSelAllBtn" Content="全选" Style="{StaticResource ActionBtn}" Click="ImgSelAll_Click" Margin="0,0,8,0"/>
                                    <Button x:Name="ImgSelFaceBtn" Content="识别人脸" Style="{StaticResource ActionBtn}" Click="ImgSelFace_Click" Margin="0,0,8,0" ToolTip="对所选图片批量识别人脸"/>
                                    <Button x:Name="ImgSelTagBtn" Content="AI 打标" Style="{StaticResource ActionBtn}" Click="ImgSelTag_Click" Margin="0,0,8,0" ToolTip="对所选图片批量 AI 打标（需 LM Studio）"/>
                                    <Button x:Name="ImgSelRemovePersonBtn" Content="移出该人物" Style="{StaticResource ActionBtn}" Click="ImgSelRemovePerson_Click"
                                            Margin="0,0,8,0" Visibility="Collapsed" ToolTip="把所选照片从当前人物中移出（照片本身不会被删除）"/>
                                    <Button x:Name="ImgSelDelBtn" Content="删除所选" Style="{StaticResource BtnDanger}" Click="ImgSelDelete_Click" Margin="0,0,8,0"/>
                                    <Button Content="取消" Style="{StaticResource BtnGhost}" Click="ImgMultiCancel_Click"/>
                                </StackPanel>
                                <!-- 人物多选操作条 -->
                                <StackPanel x:Name="PersonMultiBar" Orientation="Horizontal" Visibility="Collapsed" Margin="8,0,0,0">
                                    <TextBlock x:Name="PersonSelCount" Text="已选 0 人" Foreground="{StaticResource AccentBrush}" FontSize="{StaticResource TypeBody}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Button x:Name="PersonSelAllBtn" Content="全选" Style="{StaticResource ActionBtn}" Click="PersonSelAll_Click" Margin="0,0,8,0"/>
                                    <Button x:Name="PersonSelMergeBtn" Content="合并到…" Style="{StaticResource ActionBtn}" Click="PersonSelMerge_Click" Margin="0,0,8,0" ToolTip="把所选人物全部合并到目标人物"/>
                                    <Button x:Name="PersonSelIgnoreBtn" Content="忽略所选" Style="{StaticResource ActionBtn}" Click="PersonSelIgnore_Click" Margin="0,0,8,0"
                                            ToolTip="批量忽略所选人物：不再显示、不再标注人脸框、也不再被识别（可在设置页恢复）"/>
                                    <Button x:Name="PersonSelDelBtn" Content="删除所选" Style="{StaticResource BtnDanger}" Click="PersonSelDelete_Click" Margin="0,0,8,0"/>
                                    <Button Content="取消" Style="{StaticResource BtnGhost}" Click="PersonMultiCancel_Click"/>
                                </StackPanel>
                                </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 筛选条：识别状态 / 排序 / 来源，全部为内联分段选择（无下拉弹层，点一下即换；红线 R1 禁止改回弹层）
                                 0.61.0 批次 2b：默认收起，由 ImgFilterToggle 切换 -->
                            <Border x:Name="ImgFilterGroup" Grid.Row="2" Margin="20,0,16,10" Padding="10,7" MinHeight="44" Visibility="Collapsed"
                                    Background="{StaticResource TitleBarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="状态" Style="{StaticResource FilterGroupLabel}"/>
                                    <RadioButton x:Name="ImgStatusAllChip" Content="全部" GroupName="imgStatus" Style="{StaticResource FilterChip}" Tag="all" IsChecked="True" Checked="ImgStatusChip_Checked" ToolTip="全部状态"/>
                                    <RadioButton Content="无人脸" GroupName="imgStatus" Style="{StaticResource FilterChip}" Tag="no_face" Checked="ImgStatusChip_Checked" ToolTip="未识别人脸"/>
                                    <RadioButton Content="有人脸" GroupName="imgStatus" Style="{StaticResource FilterChip}" Tag="has_face" Checked="ImgStatusChip_Checked" ToolTip="已识别人脸"/>
                                    <RadioButton Content="已打标" GroupName="imgStatus" Style="{StaticResource FilterChip}" Tag="tagged" Checked="ImgStatusChip_Checked" ToolTip="已 AI 打标"/>
                                    <RadioButton Content="未打标" GroupName="imgStatus" Style="{StaticResource FilterChip}" Tag="untagged" Checked="ImgStatusChip_Checked" ToolTip="未 AI 打标"/>
                                    <RadioButton Content="有提示词" GroupName="imgStatus" Style="{StaticResource FilterChip}" Tag="has_prompt" Checked="ImgStatusChip_Checked" ToolTip="有关联提示词"/>

                                    <Rectangle Width="1" Height="16" Fill="{StaticResource BorderBrush}" Margin="12,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="排序" Style="{StaticResource FilterGroupLabel}"/>
                                    <RadioButton x:Name="ImgSortDateChip" Content="时间↓" GroupName="imgSort" Style="{StaticResource FilterChip}" Tag="date_desc" IsChecked="True" Checked="ImgSortChip_Checked" ToolTip="入库时间（新→旧）"/>
                                    <RadioButton Content="时间↑" GroupName="imgSort" Style="{StaticResource FilterChip}" Tag="date_asc" Checked="ImgSortChip_Checked" ToolTip="入库时间（旧→新）"/>
                                    <RadioButton Content="名称" GroupName="imgSort" Style="{StaticResource FilterChip}" Tag="name" Checked="ImgSortChip_Checked" ToolTip="文件名"/>
                                    <RadioButton Content="大小" GroupName="imgSort" Style="{StaticResource FilterChip}" Tag="size" Checked="ImgSortChip_Checked" ToolTip="文件大小"/>
                                    <RadioButton Content="像素" GroupName="imgSort" Style="{StaticResource FilterChip}" Tag="pixels" Checked="ImgSortChip_Checked" ToolTip="像素尺寸"/>

                                    <Rectangle Width="1" Height="16" Fill="{StaticResource BorderBrush}" Margin="12,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="来源" Style="{StaticResource FilterGroupLabel}"/>
                                    <!-- 来源选项在运行时按已入库的文件夹生成（见 UpdateFolderChips） -->
                                    <WrapPanel x:Name="ImgFolderChipPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                                </WrapPanel>
                            </Border>

                            <!-- 全部图片：ItemsControl+FlowWrapPanel+外层 ScrollViewer（此组合已验证可滚 SH>0）；勿改回 ListBox -->
                            <Grid Grid.Row="3">
                                    <ScrollViewer x:Name="ImgListScroll" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="False" Focusable="False" PreviewKeyDown="ImgGrid_KeyDown">
                                    <Grid>
                                    <ItemsControl x:Name="ImgGrid" Margin="12,0,6,10" Visibility="Collapsed"
                                                  Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <local:FlowWrapPanel ItemWidth="168" ItemHeight="196"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Padding="4" Margin="0,0,10,10" Cursor="{DynamicResource CurHand}"
                                                    Focusable="True"
                                                    MouseLeftButtonUp="ImgItem_Click">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Selected}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.ContextMenu>
                                                    <ContextMenu Opened="ImgCardCtx_Opened">
                                                        <MenuItem Header="打开" Click="ImgOpen_Click"/>
                                                        <MenuItem Header="打开所在文件夹" Click="ImgOpenFolder_Click"/>
                                                        <MenuItem Header="复制路径" Click="ImgCopyPath_Click"/>
                                                        <MenuItem Header="复制描述" Click="ImgCopyDesc_Click"/>
                                                        <MenuItem Header="复制图片文件" Click="ImgCopyFile_Click"/>
                                                        <Separator/>
                                                        <MenuItem Header="识别人脸（单张）" Click="ImgFaceOne_Click"/>
                                                        <MenuItem Header="AI 打标（单张）" Click="ImgTagOne_Click"/>
                                                        <Separator/>
                                                        <MenuItem x:Name="ImgCtxRemovePersonItem" Header="从这个人物中移除" Visibility="Collapsed"
                                                                  Click="ImgCtxRemovePerson_Click" ToolTip="把这张照片从当前人物中移出（照片本身不会被删除）"/>
                                                        <Separator/>
                                                        <MenuItem Header="设为桌面壁纸" Click="ImgSetWallpaper_Click"/>
                                                        <Separator/>
                                                        <MenuItem Header="重命名…" Click="ImgRename_Click"/>
                                                        <MenuItem Header="删除（回收站）" Style="{StaticResource MenuItemDanger}" Click="ImgDelete_Click"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid>
                                                    <CheckBox Style="{StaticResource MultiChk}"
                                                              IsChecked="{Binding Selected, Mode=TwoWay}"
                                                              Checked="ImgChk_Changed" Unchecked="ImgChk_Changed" ToolTip="选择"/>
                                                    <StackPanel>
                                                    <Grid>
                                                        <Image Source="{Binding Thumb}" Width="150" Height="150" Stretch="Uniform"/>
                                                        <!-- 右上角三个状态标识：人脸识别 / AI 打标 / 关联提示词（亮色=已做，暗色=未做） -->
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0">
                                                            <Border CornerRadius="3" Padding="3,1" Margin="0,0,2,0" ToolTip="人脸识别">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{StaticResource BorderStrongBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding FaceScanned}" Value="True">
                                                                                <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="脸" Foreground="White" FontSize="{StaticResource TypeBadgeGlyph}" FontWeight="SemiBold"/>
                                                            </Border>
                                                            <Border CornerRadius="3" Padding="3,1" Margin="0,0,2,0" ToolTip="AI 打标">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{StaticResource BorderStrongBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasAiTag}" Value="True">
                                                                                <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="标" Foreground="White" FontSize="{StaticResource TypeBadgeGlyph}" FontWeight="SemiBold"/>
                                                            </Border>
                                                            <Border CornerRadius="3" Padding="3,1" Margin="0,0,2,0" ToolTip="关联提示词">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{StaticResource BorderStrongBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasPrompt}" Value="True">
                                                                                <Setter Property="Background" Value="{StaticResource WarnBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="词" Foreground="White" FontSize="{StaticResource TypeBadgeGlyph}" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Filename}" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" Margin="2,4,2,2" MaxWidth="146" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 人物卡片 -->
                                <ItemsControl x:Name="PersonGrid" Margin="12,0,6,10" Visibility="Collapsed">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <local:FlowWrapPanel ItemWidth="172" ItemHeight="220"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="0" Margin="0,0,12,12" Width="160" Cursor="{DynamicResource CurHand}"
                                                    PreviewMouseLeftButtonUp="PersonItem_Click">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="重命名…" Click="PersonRename_Click"/>
                                                        <MenuItem Header="更换封面…" Click="PersonSetAvatar_Click"/>
                                                        <MenuItem Header="合并到其他人物…" Click="PersonMerge_Click"/>
                                                        <MenuItem Header="忽略该人物" Click="PersonIgnore_Click" ToolTip="不再显示、也不再识别该人物（可在设置页恢复）"/>
                                                        <Separator/>
                                                        <MenuItem Header="删除人物" Style="{StaticResource MenuItemDanger}" Click="PersonDelete_Click"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="160"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Border Grid.Row="0" Background="{StaticResource OverlayBrush}" CornerRadius="10" ClipToBounds="True">
                                                        <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                                                    </Border>
                                                    <!-- 多选勾选框（仅人物多选模式显示） -->
                                                    <CheckBox Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0"
                                                              Style="{StaticResource CheckBoxDark}" IsChecked="{Binding IsSelected}"
                                                              Visibility="{Binding MultiMode, Converter={StaticResource BoolVis}}"
                                                              Click="PersonChk_Click" Tag="{Binding Id}" Panel.ZIndex="2"/>
                                                    <!-- 多选模式覆盖层：拦截整卡点击，统一切换勾选 -->
                                                    <Border Grid.RowSpan="2" Background="Transparent" Panel.ZIndex="1"
                                                            Visibility="{Binding MultiMode, Converter={StaticResource BoolVis}}"
                                                            MouseLeftButtonUp="PersonMultiCard_Click" Tag="{Binding Id}"/>
                                                    <StackPanel Grid.Row="1" Margin="10,8,10,10">
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource TypeBodyLg}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding PhotoCountText}" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                    </Grid>
                                    </ScrollViewer>

                                <!-- 标签列表（默认 Top200，可用标签搜索框过滤；宽度随文字，保留 WrapPanel）
                                     注意：本 ScrollViewer 是 ImgListScroll 之后的兄弟节点，会盖在它上面。
                                     只折叠内部的 TagGrid 不够——空的 ScrollViewer 外壳仍会吃掉
                                     图片库滚动条的鼠标输入（表现为「图片库滚动条点不动、拖不动」，
                                     已用探针命中测试证实）。故把自身可见性绑定到 TagGrid，两者始终同步。 -->
                                <ScrollViewer x:Name="TagListScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              Visibility="{Binding Visibility, ElementName=TagGrid}">
                                    <ItemsControl x:Name="TagGrid" Margin="12,0,6,10" Visibility="Collapsed">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="12,6" Margin="0,0,8,8" Cursor="{DynamicResource CurHand}"
                                                        MouseLeftButtonUp="TagItem_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource TypeBody}"/>
                                                        <TextBlock Text="{Binding CountText}" Foreground="{StaticResource AccentBrush}" FontSize="{StaticResource TypeCaption}" Margin="6,0,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <!-- 空态三件套：主句(TypeDisplay) + 副句(TypeBody) + 行动按钮，按上下文动态显示 -->
                                <StackPanel x:Name="ImgEmptyBox" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock x:Name="ImgEmptyTitle" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource TypeDisplay}" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440"/>
                                    <TextBlock x:Name="ImgEmptyHint" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeBody}"
                                               Margin="0,10,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440"/>
                                    <Button x:Name="ImgEmptyAction" Style="{StaticResource BtnPrimary}" Margin="0,18,0,0" HorizontalAlignment="Center"
                                            Click="ImgEmptyAction_Click" Visibility="Collapsed"/>
                                </StackPanel>
                                <Border x:Name="ImgLoadingMask" Background="{StaticResource OverlayBrush}" Visibility="Collapsed" IsHitTestVisible="False">
                                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource PanelAltBrush}" CornerRadius="10" Padding="22,12">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="◌" Foreground="{StaticResource AccentBrush}" FontSize="{StaticResource TypeTitle}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ImgLoadingText" Text="加载中…" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource TypeBodyLg}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Border>
                                </Grid>

                            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Button x:Name="ImgPrevBtn" Content="‹ 上一页" Style="{StaticResource ActionBtn}" Click="ImgPrev_Click" IsEnabled="False"/>
                                <!-- 页码按钮（代码动态生成，点击直达；网格与滚动逻辑不受影响） -->
                                <ItemsControl x:Name="ImgPageBar" VerticalAlignment="Center" Margin="10,0" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Button x:Name="ImgNextBtn" Content="下一页 ›" Style="{StaticResource ActionBtn}" Click="ImgNext_Click" IsEnabled="False"/>
                                <TextBlock x:Name="ImgPageText" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeBody}" VerticalAlignment="Center" Margin="14,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- ===== 设置视图 ===== -->
                        <Grid x:Name="SettingsView" Visibility="Collapsed" Margin="20,16,10,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="设置" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource TypeSection}" FontWeight="SemiBold"/>
                            <!-- 0.61.0 批次 3：二级侧栏（180px）+ 滚动面板；点击导航滚动定位到对应区块 -->
                            <Grid Grid.Row="1" Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Margin="0,0,6,0">
                                    <StackPanel Margin="0,4,10,0">
                                        <TextBlock Text="设置分类" Foreground="{StaticResource TextFaintBrush}" FontSize="{StaticResource TypeCaption}" Margin="12,0,0,6"/>
                                        <RadioButton x:Name="SetNavAppearance" Content="外观" Style="{StaticResource SetNavBtn}" GroupName="setNav" IsChecked="True" Checked="SetNav_Checked"/>
                                        <RadioButton x:Name="SetNavPrompts" Content="提示词" Style="{StaticResource SetNavBtn}" GroupName="setNav" Checked="SetNav_Checked"/>
                                        <RadioButton x:Name="SetNavLibrary" Content="图片库" Style="{StaticResource SetNavBtn}" GroupName="setNav" Checked="SetNav_Checked"/>
                                        <RadioButton x:Name="SetNavFace" Content="人脸识别" Style="{StaticResource SetNavBtn}" GroupName="setNav" Checked="SetNav_Checked"/>
                                        <RadioButton x:Name="SetNavTagging" Content="AI 打标" Style="{StaticResource SetNavBtn}" GroupName="setNav" Checked="SetNav_Checked"/>
                                        <RadioButton x:Name="SetNavIgnored" Content="已忽略人物" Style="{StaticResource SetNavBtn}" GroupName="setNav" Checked="SetNav_Checked"/>
                                        <RadioButton x:Name="SetNavComfy" Content="ComfyUI 监听" Style="{StaticResource SetNavBtn}" GroupName="setNav" Checked="SetNav_Checked"/>
                                        <RadioButton x:Name="SetNavData" Content="数据" Style="{StaticResource SetNavBtn}" GroupName="setNav" Checked="SetNav_Checked"/>
                                        <RadioButton x:Name="SetNavAbout" Content="关于" Style="{StaticResource SetNavBtn}" GroupName="setNav" Checked="SetNav_Checked"/>
                                    </StackPanel>
                                </Border>
                                <ScrollViewer x:Name="SettingsScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel MaxWidth="640" HorizontalAlignment="Left">

                                    <TextBlock x:Name="SetSecAppearance" Text="外观" Foreground="{StaticResource AccentBrush}" FontSize="{StaticResource TypeBody}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="界面主题" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" Margin="0,0,0,8"/>
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="ThemeDark" Content="深色" GroupName="theme" Style="{StaticResource OptionBtn}" Checked="Theme_Changed"/>
                                                <RadioButton x:Name="ThemeLight" Content="浅色" GroupName="theme" Style="{StaticResource OptionBtn}" Checked="Theme_Changed"/>
                                            </StackPanel>
                                            <TextBlock Text="主题字典在启动时装载，切换需要重启 PictureButler。正在进行的扫描 / 打标任务会被中断。"
                                                       Foreground="{StaticResource TextFaintBrush}" FontSize="{StaticResource TypeCaption}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock x:Name="SetSecPrompts" Text="提示词" Foreground="{StaticResource AccentBrush}" FontSize="{StaticResource TypeBody}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                                        <StackPanel>
                                            <CheckBox x:Name="AutoStartChk" Style="{StaticResource CheckBoxDark}" Content="开机自动启动 PictureButler" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource TypeBodyLg}"
                                                      Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/>
                                            <TextBlock Text="提示词卡片尺寸" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" Margin="0,14,0,8"/>
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="CardCompact" Content="紧凑" GroupName="cardSize" Style="{StaticResource OptionBtn}" Checked="CardSize_Changed"/>
                                                <RadioButton x:Name="CardStandard" Content="标准" GroupName="cardSize" Style="{StaticResource OptionBtn}" Checked="CardSize_Changed"/>
                                                <RadioButton x:Name="CardRoomy" Content="宽松" GroupName="cardSize" Style="{StaticResource OptionBtn}" Checked="CardSize_Changed"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock x:Name="SetSecLibrary" Text="图片库" Foreground="{StaticResource AccentBrush}" FontSize="{StaticResource TypeBody}" FontWeight="SemiBold" Margin="0,8,0,10"/>
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="图片文件夹来源（自定义，可添加任意文件夹）" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" Margin="0,0,0,8"/>
                                            <ListBox x:Name="FolderList" Height="120" Background="{StaticResource PanelDeepBrush}" BorderBrush="{StaticResource HoverBrush}"
                                                     Foreground="{StaticResource TextBrush}" FontSize="{StaticResource TypeBody}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,2">
                                                            <Button Content="移除" Style="{StaticResource ActionBtn}" DockPanel.Dock="Right"
                                                                    Height="24" FontSize="{StaticResource TypeCaption}" Padding="10,0" Click="RemoveFolder_Click" Tag="{Binding}"/>
                                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button Content="添加文件夹…" Style="{StaticResource ActionBtn}" Click="AddFolder_Click"/>
                                                <Button Content="立即扫描" Style="{StaticResource ActionBtn}" Click="ScanFolders_Click" Margin="8,0,0,0"/>
                                                <TextBlock x:Name="ScanStatus" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="本地识别库路径（人脸识别 / 标签 / 描述数据，已内置，一般无需修改）" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" Margin="0,16,0,6"/>
                                            <DockPanel>
                                                <Button Content="浏览…" Style="{StaticResource ActionBtn}" DockPanel.Dock="Right" Click="BrowseImgDb_Click" Margin="8,0,0,0"/>
                                                <TextBox x:Name="ImgDbPathBox" Style="{StaticResource SearchBox}" Height="32" VerticalContentAlignment="Center"/>
                                            </DockPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button Content="测试并保存" Style="{StaticResource ActionBtn}" Click="SaveImgDb_Click"/>
                                                <TextBlock x:Name="ImgDbStatus" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="图片每页张数" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" Margin="0,16,0,8"/>
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="Page30" Content="30" GroupName="pageSize" Style="{StaticResource OptionBtn}" Checked="PageSize_Changed"/>
                                                <RadioButton x:Name="Page60" Content="60" GroupName="pageSize" Style="{StaticResource OptionBtn}" Checked="PageSize_Changed"/>
                                                <RadioButton x:Name="Page90" Content="90" GroupName="pageSize" Style="{StaticResource OptionBtn}" Checked="PageSize_Changed"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- ===== 人脸识别设置（0.50 起） ===== -->
                                    <TextBlock x:Name="SetSecFace" Text="人脸识别" Foreground="{StaticResource AccentBrush}" FontSize="{StaticResource TypeBody}" FontWeight="SemiBold" Margin="0,8,0,10"/>
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                                        <StackPanel>
                                            <!-- 引擎状态 -->
                                            <DockPanel>
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                    <Ellipse x:Name="FaceEngineDot" Width="9" Height="9" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock x:Name="FaceEngineStatus" Text="识别引擎已就绪" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource TypeBody}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="ONNX 进程内 · 模型已加载" Foreground="{StaticResource TextFaintBrush}" FontSize="{StaticResource TypeCaption}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,0"/>
                                            <!-- 检测灵敏度（写入识别库 face_det_thresh，引擎重启后生效） -->
                                            <TextBlock Text="检测灵敏度" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" Margin="0,14,0,8"/>
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="FaceSensLow" Content="低（漏检少、误检多）" GroupName="faceSens" Style="{StaticResource OptionBtn}" Checked="FaceSensitivity_Changed"/>
                                                <RadioButton x:Name="FaceSensStandard" Content="标准" GroupName="faceSens" Style="{StaticResource OptionBtn}" Checked="FaceSensitivity_Changed"/>
                                                <RadioButton x:Name="FaceSensHigh" Content="高（严格、误检少）" GroupName="faceSens" Style="{StaticResource OptionBtn}" Checked="FaceSensitivity_Changed"/>
                                            </StackPanel>
                                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,0"/>
                                            <!-- 最小人脸尺寸（写入识别库 face_min_size；下限 20 与引擎 clamp 一致） -->
                                            <TextBlock Text="最小人脸尺寸（像素）" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" Margin="0,14,0,8"/>
                                            <DockPanel>
                                                <TextBlock x:Name="FaceMinSizeText" Text="48 px" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource TypeCaption}" FontWeight="SemiBold" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                <Slider x:Name="FaceMinSizeSlider" Minimum="20" Maximum="160" Value="48" TickFrequency="8" IsSnapToTickEnabled="True"
                                                        Style="{StaticResource SliderDark}" ValueChanged="FaceMinSize_Changed" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <TextBlock Text="数值越小检测越小的人脸，速度越慢" Foreground="{StaticResource TextFaintBrush}" FontSize="{StaticResource TypeMicro}" Margin="0,4,0,0"/>
                                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,0"/>
                                            <!-- 自动识别 -->
                                            <CheckBox x:Name="FaceAutoRecogChk" Style="{StaticResource CheckBoxDark}" Content="自动识别新入库的图片" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource TypeBodyLg}"
                                                      Checked="FaceAutoRecognize_Changed" Unchecked="FaceAutoRecognize_Changed" Margin="0,14,0,0"/>
                                            <TextBlock Text="添加文件夹或 ComfyUI 入库后自动识别人脸，无需手动触发" Foreground="{StaticResource TextFaintBrush}" FontSize="{StaticResource TypeMicro}" TextWrapping="Wrap" LineHeight="16" Margin="28,4,0,0"/>
                                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,0"/>
                                            <!-- 人物聚类灵敏度（写入识别库 face_sim_thresh） -->
                                            <TextBlock Text="人物聚类灵敏度" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" Margin="0,14,0,8"/>
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="FaceClusterConservative" Content="保守（宁可不合并）" GroupName="faceCluster" Style="{StaticResource OptionBtn}" Checked="FaceClusterSensitivity_Changed"/>
                                                <RadioButton x:Name="FaceClusterStandard" Content="标准" GroupName="faceCluster" Style="{StaticResource OptionBtn}" Checked="FaceClusterSensitivity_Changed"/>
                                                <RadioButton x:Name="FaceClusterAggressive" Content="积极（可能把相似的合并）" GroupName="faceCluster" Style="{StaticResource OptionBtn}" Checked="FaceClusterSensitivity_Changed"/>
                                            </StackPanel>
                                            <TextBlock Text="聚类结果可在人物页手动合并 / 拆分修正" Foreground="{StaticResource TextFaintBrush}" FontSize="{StaticResource TypeMicro}" Margin="0,4,0,0"/>
                                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,0"/>
                                            <!-- 人脸缩略图缓存 -->
                                            <TextBlock Text="人脸缩略图缓存" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" Margin="0,14,0,8"/>
                                            <DockPanel>
                                                <Button Content="清理缩略图缓存" Style="{StaticResource ActionBtn}" DockPanel.Dock="Right" Click="ClearFaceThumbnails_Click" ToolTip="删除人脸裁剪缩略图缓存，下次查看人物/人脸时会重新生成"/>
                                                <TextBlock x:Name="FaceThumbStats" Text="0 张人脸 · 0 MB" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource TypeBody}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,0"/>
                                            <!-- 操作区 -->
                                            <TextBlock Text="操作" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" Margin="0,14,0,8"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="扫描全部未识别图片" Style="{StaticResource ActionBtn}" Click="FaceScanUnscanned_Click"/>
                                                <Button Content="强制重新扫描全部" Style="{StaticResource ActionBtn}" Margin="8,0,0,0" Click="FaceRescanAll_Click"/>
                                            </StackPanel>
                                            <TextBlock x:Name="FaceScanStats" Text="已识别 0 / 0 张 · 人脸 0 个" Foreground="{StaticResource TextFaintBrush}" FontSize="{StaticResource TypeCaption}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock x:Name="SetSecTagging" Text="AI 打标" Foreground="{StaticResource AccentBrush}" FontSize="{StaticResource TypeBody}" FontWeight="SemiBold" Margin="0,8,0,10"/>
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="由 LM Studio 视觉模型生成图片描述与标签（需 LM Studio 运行并已加载视觉模型）。"
                                                       Foreground="{StaticResource TextFaintBrush}" FontSize="{StaticResource TypeCaption}" TextWrapping="Wrap" LineHeight="16"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button Content="打标未打标图片" Style="{StaticResource ActionBtn}" Click="TagPending_Click" ToolTip="只处理尚未打标的图片，增量、较快"/>
                                                <Button x:Name="TagAllBtn" Content="全部重新打标" Style="{StaticResource ActionBtn}" Margin="8,0,0,0" Click="TagAll_Click"
                                                        ToolTip="忽略已有结果，对全部图片重新打标。单张约 20 秒，图多时耗时很长，可随时点「停止」中断"/>
                                                <Button x:Name="TagStopBtn" Content="停止" Style="{StaticResource BtnDanger}" Margin="8,0,0,0" Visibility="Collapsed"
                                                        Click="TagStop_Click" ToolTip="中断当前打标任务（在当前图片处理完之后生效）"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TagStatus" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}"
                                                       Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="16"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock x:Name="SetSecIgnored" Text="已忽略人物" Foreground="{StaticResource AccentBrush}" FontSize="{StaticResource TypeBody}" FontWeight="SemiBold" Margin="0,8,0,10"/>
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="被忽略的人物不再出现在人物列表、不再在图片上标注人脸框，后续人脸识别也不会再把它识别出来。"
                                                       Foreground="{StaticResource TextFaintBrush}" FontSize="{StaticResource TypeCaption}" TextWrapping="Wrap" LineHeight="16"/>

                                            <TextBlock x:Name="IgnoredEmptyText" Text="没有被忽略的人物" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" Margin="0,8,0,0"/>

                                            <!-- 折叠头：默认收起，避免忽略条目多时列表过长 -->
                                            <Border x:Name="IgnoredToggle" Cursor="{DynamicResource CurHand}" Background="Transparent" Padding="0,8,0,2"
                                                    Visibility="Collapsed" MouseLeftButtonUp="IgnoredToggle_Click"
                                                    ToolTip="展开 / 收起已忽略人物列表">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="IgnoredArrow" Text="▸" Foreground="{StaticResource AccentBrush}" FontSize="{StaticResource TypeBody}" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="IgnoredCountText" Text="已忽略人物（0）" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource TypeBody}"
                                                               FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="IgnoredToggleHint" Text="点击展开" Foreground="{StaticResource TextFaintBrush}" FontSize="{StaticResource TypeCaption}"
                                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <ScrollViewer x:Name="IgnoredScroll" Visibility="Collapsed" MaxHeight="260"
                                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0">
                                                <ItemsControl x:Name="IgnoredPersonList">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel Margin="0,3">
                                                                <Button Content="恢复" Style="{StaticResource ActionBtn}" DockPanel.Dock="Right" Height="24"
                                                                        FontSize="{StaticResource TypeCaption}" Padding="10,0"
                                                                        Click="RestoreIgnoredPerson_Click" Tag="{Binding Id}" ToolTip="恢复该人物在列表中的显示与后续识别"/>
                                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource TypeBody}"
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock x:Name="SetSecComfy" Text="ComfyUI 监听" Foreground="{StaticResource AccentBrush}" FontSize="{StaticResource TypeBody}" FontWeight="SemiBold" Margin="0,8,0,10"/>
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                                        <StackPanel>
                                            <CheckBox x:Name="ComfyMonitorChk" Style="{StaticResource CheckBoxDark}" Content="监听 ComfyUI 生成结果（自动保存提示词和图片）" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource TypeBodyLg}"
                                                      Checked="ComfyMonitor_Changed" Unchecked="ComfyMonitor_Changed"/>
                                            <TextBlock Text="ComfyUI 地址" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" Margin="0,14,0,6"/>
                                            <TextBox x:Name="ComfyUrlBox" Style="{StaticResource SearchBox}" Height="32" VerticalContentAlignment="Center"
                                                     TextChanged="ComfyUrl_Changed"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button Content="立即检测" Style="{StaticResource ActionBtn}" Click="TestComfy_Click"/>
                                                <TextBlock x:Name="ComfyStatus" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="生成完成后自动保存为「ComfyUI · 模型 · 时间」的提示词卡片，包含正向提示词与输出图预览；相同提示词自动合并追加图片。" Foreground="{StaticResource TextFaintBrush}" FontSize="{StaticResource TypeCaption}" TextWrapping="Wrap" LineHeight="16" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock x:Name="SetSecData" Text="数据" Foreground="{StaticResource AccentBrush}" FontSize="{StaticResource TypeBody}" FontWeight="SemiBold" Margin="0,8,0,10"/>
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16,14">
                                        <StackPanel>
                                            <TextBlock x:Name="DataInfoText" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" TextWrapping="Wrap" LineHeight="20"/>
                                            <!-- 危险区：以下操作不可撤销 -->
                                            <Border Background="{StaticResource DangerSoftBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="{StaticResource R2}" Padding="10,7" Margin="0,12,0,0">
                                                <TextBlock Text="以下操作不可撤销，请谨慎执行" Foreground="{StaticResource DangerBrush}" FontSize="{StaticResource TypeCaption}" TextWrapping="Wrap"/>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <Button Content="清理空人物" Style="{StaticResource BtnDanger}" Click="PrunePersons_Click" ToolTip="删除没有任何有效人脸的空人物（主动忽略的人物不受影响）"/>
                                                <TextBlock x:Name="PruneStatus" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button Content="清空缩略图缓存" Style="{StaticResource BtnDanger}" Click="ClearThumbCache_Click" ToolTip="删除本地缩略图磁盘缓存，下次浏览图片库时会重新生成（可解决缓存异常、释放磁盘空间）"/>
                                                <TextBlock x:Name="ThumbCacheStatus" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button Content="清理失效图片索引" Style="{StaticResource BtnDanger}" Click="CleanMissingIndex_Click"
                                                        ToolTip="删除索引中「磁盘文件已不存在」的记录（不动磁盘文件）。用于清理已删除文件夹留下的残留，来源筛选会随之更新"/>
                                                <TextBlock x:Name="CleanMissingStatus" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- ===== 关于：版本号在设置页显示（用户 2026-09-14 约定），纯数字不带前后缀 ===== -->
                                    <TextBlock x:Name="SetSecAbout" Text="关于" Foreground="{StaticResource AccentBrush}" FontSize="{StaticResource TypeBody}" FontWeight="SemiBold" Margin="0,8,0,10"/>
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="PictureButler" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource TypeBodyLg}" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="SettingsVersionText" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" Margin="0,6,0,0" Text="版本读取中…"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                </ScrollViewer>
                                </Grid>
                        </Grid>
                    </Grid>

                <!-- 右栏：详情面板 -->
                <Border Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Margin="10,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DetailPanel" Margin="18,20,18,24" Visibility="Collapsed">
                            <DockPanel>
                                <Button x:Name="DetailStarBtn" Content="★" FontSize="{StaticResource TypeTitle}" Width="34" Height="28"
                                        Background="Transparent" BorderThickness="0" Cursor="{DynamicResource CurHand}" Click="DetailStarBtn_Click"/>
                                <TextBlock x:Name="DetailTitle" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource TypeSection}" FontWeight="SemiBold"
                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBlock x:Name="DetailMeta" Foreground="{StaticResource TextFaintBrush}" FontSize="{StaticResource TypeCaption}" Margin="0,6,0,0" TextWrapping="Wrap"/>

                            <TextBlock Text="提示词内容" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" Margin="0,18,0,6"/>
                            <Border Background="{StaticResource PanelDeepBrush}" CornerRadius="8" Padding="12,10">
                                <TextBlock x:Name="DetailContent" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource TypeBody}" TextWrapping="Wrap" LineHeight="21"/>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="复制内容" Style="{StaticResource ActionBtn}" Click="CopyContent_Click"/>
                                <Button Content="复制标题" Style="{StaticResource ActionBtn}" Click="CopyTitle_Click" Margin="8,0,0,0"/>
                                <Button Content="编辑" Style="{StaticResource ActionBtn}" Click="EditPrompt_Click" Margin="8,0,0,0"/>
                                <Button Content="删除" Style="{StaticResource BtnDanger}" Click="DeletePrompt_Click" Margin="8,0,0,0"/>
                            </StackPanel>

                            <TextBlock Text="预览图" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" Margin="0,20,0,6"/>
                            <Border Background="{StaticResource PanelDeepBrush}" CornerRadius="8" Padding="8" HorizontalAlignment="Left" MaxWidth="300">
                                <Image x:Name="DetailPreview" MaxWidth="280" MaxHeight="240" Stretch="Uniform"/>
                            </Border>

                            <TextBlock x:Name="GalleryLabel" Text="图片集" Foreground="{StaticResource TextDimBrush}" FontSize="{StaticResource TypeCaption}" Margin="0,18,0,6"/>
                            <ItemsControl x:Name="GalleryList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource PanelDeepBrush}" CornerRadius="6" Padding="3" Margin="0,0,8,8" Cursor="{DynamicResource CurHand}">
                                            <Image Source="{Binding}" Width="110" Height="110" Stretch="Uniform"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== 常驻状态条（0.61.0 批次 2b）：28px，服务状态左 / 任务状态右，全视图可见 ===== -->
        <Border Grid.Row="2" Background="{StaticResource TitleBarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- 服务状态：镜像侧栏 HttpStatusText（文本与着色同步） -->
                <TextBlock Grid.Column="0" Foreground="{Binding Foreground, ElementName=HttpStatusText}" FontSize="{StaticResource TypeMicro}"
                           Text="{Binding Text, ElementName=HttpStatusText}" VerticalAlignment="Center"/>
                <Rectangle Grid.Column="1" Fill="{StaticResource BorderBrush}" Margin="12,7"/>
                <!-- 任务状态：镜像图片库工具条的 ImgRecognizeStatus（识别 / 打标进度的唯一汇合点） -->
                <TextBlock Grid.Column="2" Foreground="{Binding Foreground, ElementName=ImgRecognizeStatus}" FontSize="{StaticResource TypeMicro}"
                           Text="{Binding Text, ElementName=ImgRecognizeStatus}" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusVersionText" Grid.Column="4" Foreground="{StaticResource TextFaintBrush}" FontSize="{StaticResource TypeMicro}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
